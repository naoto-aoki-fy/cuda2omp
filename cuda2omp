#!/usr/bin/env python3
"""AST-directed CUDA-to-C++20 coroutine prototype."""
import argparse, json, os, pathlib, subprocess, sys, tempfile

ROOT = pathlib.Path(__file__).resolve().parent
SHIM = ROOT / "runtime" / "cuda_frontend_shim.hpp"

def loc(n, which):
    x = n["range"][which]
    x = x.get("expansionLoc", x)
    return x.get("offset"), x.get("tokLen", 1)

def walk(n):
    yield n
    for c in n.get("inner", []): yield from walk(c)

def child(n, kind):
    return next((x for x in n.get("inner", []) if x.get("kind") == kind), None)

def refname(n):
    for x in walk(n):
        if x.get("kind") == "DeclRefExpr" and x.get("referencedDecl"):
            return x["referencedDecl"].get("name")

def resolved_callee(n):
    """Return the declaration behind a direct call, not a referenced variable."""
    if not n.get("inner"): return None
    for x in walk(n["inner"][0]):
        if x.get("kind")=="DeclRefExpr": return x.get("referencedDecl")

# These sets are deliberately explicit.  Adding syntax to the lowerer requires
# adding it here too, so an unfamiliar CUDA AST node can never silently leak
# into the generated host program.
CUDA_DECLARATIONS = {"FunctionDecl", "ParmVarDecl", "VarDecl"}
CUDA_EXPRESSIONS = {
    "ArraySubscriptExpr", "BinaryOperator", "BreakStmt", "CallExpr",
    "CompoundAssignOperator", "CompoundStmt", "ConditionalOperator",
    "CStyleCastExpr", "CXXBoolLiteralExpr", "CXXFunctionalCastExpr",
    "CXXStaticCastExpr", "DeclRefExpr", "DeclStmt", "DoStmt", "FloatingLiteral",
    "ForStmt", "IfStmt", "ImplicitCastExpr", "IntegerLiteral", "MemberExpr",
    "NullStmt", "ParenExpr", "ReturnStmt", "UnaryOperator", "VarDecl", "WhileStmt",
}
CUDA_BUILTINS = {"threadIdx", "blockIdx", "blockDim", "gridDim"}
CUDA_BUILTIN_MEMBERS = {"x"}
CUDA_LAUNCH_FORMS = {"CUDAKernelCallExpr", "cudaLaunchKernel"}
CUDA_STORAGE_ATTRIBUTES = {"CUDADeviceAttr", "CUDAGlobalAttr", "CUDASharedAttr"}
CUDA_CALL_TARGETS = {"__syncthreads"} # CUDA functions in this TU are added below.

def point(n, which="begin"):
    p=n.get("range",{}).get(which) or n.get("loc",{})
    return p.get("expansionLoc",p)

def in_main(n, size):
    p=point(n)
    return "includedFrom" not in p and p.get("offset",size+1) <= size

def validate(tree, src, filename):
    """Validate the complete CUDA subset before the first output-side effect."""
    errors=[]; size=len(src); absolute=str(pathlib.Path(filename).resolve())
    parents={}
    def index(n):
        for c in n.get("inner",[]): parents[id(c)]=n; index(c)
    index(tree)
    def complain(n, message):
        p=point(n); off=p.get("offset")
        # Clang sometimes omits repeated line/column fields in JSON.
        if in_main(n,size) and off is not None:
            line=src.count("\n",0,off)+1; start=src.rfind("\n",0,off)+1; col=off-start+1
            path=absolute
        else:
            path=p.get("file") or p.get("includedFrom",{}).get("file") or absolute
            line=p.get("line",1); col=p.get("col",1)
        errors.append((path,line,col,message))
    def macro_range(n):
        for which in ("begin","end"):
            p=n.get("range",{}).get(which,{})
            if "spellingLoc" not in p: continue
            spelling=p["spellingLoc"]; expansion=p.get("expansionLoc",{})
            # CUDA keywords are macros in our forced shim; unlike a user macro,
            # their spelling lives in an included file and is safe to ignore.
            if expansion.get("isMacroArgExpansion") or "includedFrom" not in spelling:
                return True
        return False
    nodes=list(walk(tree))
    cuda_funcs=[]
    for n in nodes:
        attrs={x.get("kind") for x in n.get("inner",[]) if x.get("kind")}
        cuda_attrs=attrs & CUDA_STORAGE_ATTRIBUTES
        unknown_cuda_attrs={a for a in attrs if a.startswith("CUDA") and a.endswith("Attr")} - CUDA_STORAGE_ATTRIBUTES
        if in_main(n,size) and unknown_cuda_attrs:
            complain(n,"unsupported CUDA storage attribute "+", ".join(sorted(unknown_cuda_attrs)))
        if n.get("kind")=="FunctionDecl" and attrs & {"CUDADeviceAttr","CUDAGlobalAttr"}:
            if n.get("isImplicit"):
                continue
            # Ignore shim/system machinery but reject user CUDA declarations in includes.
            if in_main(n,size):
                if child(n,"CompoundStmt"): cuda_funcs.append(n)
                else: complain(n,"CUDA function declarations without a definition are unsupported")
            else:
                p=point(n)
                origin=p.get("file","")
                if origin.endswith((".cu",".cuh")):
                    complain(n,"CUDA declaration from a non-main file is unsupported")
        if in_main(n,size) and cuda_attrs and n.get("kind") not in CUDA_DECLARATIONS:
            complain(n,f"CUDA attribute on unsupported declaration {n.get('kind')}" )
        if in_main(n,size) and attrs & ({"CUDAConstantAttr","CUDAManagedAttr"}):
            complain(n,"device/global CUDA variables are unsupported")
        if in_main(n,size) and n.get("kind")=="VarDecl" and attrs & {"CUDADeviceAttr","CUDAGlobalAttr"}:
            complain(n,"device/global CUDA variables are unsupported")
        if in_main(n,size) and n.get("kind") in {"FunctionTemplateDecl","ClassTemplateDecl","VarTemplateDecl"}:
            complain(n,"templates are unsupported")
    names={f.get("name") for f in cuda_funcs}
    kernel_names={f.get("name") for f in cuda_funcs if any(x.get("kind")=="CUDAGlobalAttr" for x in f.get("inner",[]))}
    byname={name:[f for f in cuda_funcs if f.get("name")==name] for name in names}
    for name, fs in byname.items():
        if len(fs)>1:
            for f in fs: complain(f,f"overloaded CUDA function '{name}' is ambiguous")
    edges={name:set() for name in names}
    for f in cuda_funcs:
        body=child(f,"CompoundStmt")
        if not body: continue
        is_kernel=any(x.get("kind")=="CUDAGlobalAttr" for x in f.get("inner",[]))
        for n in walk(body):
            kind=n.get("kind")
            if kind not in CUDA_EXPRESSIONS and not kind.endswith("Attr"):
                complain(n,f"unsupported CUDA expression {kind}")
            if kind=="MemberExpr":
                base=refname(n)
                if base in CUDA_BUILTINS and n.get("name") not in CUDA_BUILTIN_MEMBERS:
                    complain(n,f".{n.get('name')} of {base} is unsupported; only .x is supported")
            if kind=="CallExpr":
                callee=resolved_callee(n); target=callee.get("name") if callee else None
                if not callee or callee.get("kind") not in {"FunctionDecl","FunctionTemplateDecl"}:
                    complain(n,"indirect calls are unsupported")
                elif target not in CUDA_CALL_TARGETS | names:
                    complain(n,f"call target '{target}' is unsupported in CUDA code")
                elif target in names: edges[f.get("name")].add(target)
            if kind=="VarDecl":
                attrs={x.get("kind") for x in n.get("inner",[])}
                if "CUDASharedAttr" in attrs:
                    declstmt=parents.get(id(n)); scope=parents.get(id(declstmt))
                    typ=n.get("type",{}).get("qualType","")
                    if not is_kernel or not declstmt or declstmt.get("kind")!="DeclStmt" or scope is not body:
                        complain(n,"shared declaration must be directly kernel-local")
                    elif n.get("storageClass")!="static" or "[" not in typ or not typ.rstrip().endswith("]") or "[]" in typ:
                        complain(n,"only fixed-size kernel-local shared arrays are supported")
            # Rewritten ranges must have a single main-file spelling.
            if kind in {"MemberExpr","CallExpr","VarDecl"}:
                if macro_range(n):
                    complain(n,"macro range cannot be rewritten")
    visiting=set(); done=set()
    def dfs(name):
        if name in visiting: return True
        if name in done: return False
        visiting.add(name)
        recursive=any(dfs(c) for c in edges[name])
        visiting.remove(name); done.add(name)
        return recursive
    for name in names:
        if dfs(name): complain(byname[name][0],f"recursive CUDA call involving '{name}' is unsupported")
    for n in nodes:
        if not in_main(n,size): continue
        if n.get("kind")=="CUDAKernelCallExpr":
            if refname(n) not in kernel_names: complain(n,"launch target is not a supported kernel definition")
            raw=source_text(src,n) or ""
            p=raw.find("<<<"); q=raw.find(">>>",p)
            if p<0 or q<0 or len(raw[p+3:q].split(','))!=2:
                complain(n,"only <<<grid, block>>> launches are supported")
            if macro_range(n):
                complain(n,"macro range cannot be rewritten")
        elif n.get("kind")=="CallExpr" and refname(n)=="cudaLaunchKernel":
            parts=n.get("inner",[])
            if len(parts)<5: complain(n,"malformed cudaLaunchKernel launch")
            else:
                target=refname(parts[1]) if len(parts)>1 else None
                if target not in kernel_names: complain(n,"cudaLaunchKernel target is not a supported kernel definition")
                actual=[source_text(src,p) for p in parts[5:7]]
                allowed=({"0"},{"0","nullptr","NULL"})
                if any(v is not None and v.strip() not in allowed[i] for i,v in enumerate(actual)):
                    complain(n,"dynamic shared memory and streams are unsupported")
    if errors:
        for path,line,col,message in errors:
            print(f"{path}:{line}:{col}: error: {message}",file=sys.stderr)
        raise SystemExit(1)

def ast(source, clang):
    cmd=[clang,"-std=c++20","-x","cuda","--cuda-host-only","-nocudainc","-nocudalib",
         "-include",str(SHIM),"-Xclang","-ast-dump=json","-fsyntax-only",source]
    p=subprocess.run(cmd,text=True,capture_output=True)
    if p.returncode:
        sys.stderr.write(p.stderr); raise SystemExit("cuda2omp: Clang CUDA parse failed")
    return json.loads(p.stdout)

def apply(text, edits):
    for a,b,s in sorted(edits, reverse=True): text=text[:a]+s+text[b:]
    return text

def source_text(src, n):
    """Return the spelling covered by an AST node, excluding default arguments."""
    if n.get("kind") == "CXXDefaultArgExpr" or "range" not in n: return None
    a,_=loc(n,"begin"); z,l=loc(n,"end")
    if a is None or z is None: return None
    return src[a:z+l]

def transform_body(src, body, device_names, shared_nodes, ret):
    a,_=loc(body,"begin"); z,l=loc(body,"end"); base=a; text=src[a:z+l]; edits=[]
    shared_names={v["name"] for v in shared_nodes}
    nodes=list(walk(body))
    # Semantic references to CUDA builtins and block shared declarations.
    for n in nodes:
        if n.get("kind")=="MemberExpr":
            rn=refname(n)
            if rn in {"threadIdx","blockIdx","blockDim","gridDim"}:
                x,_=loc(n,"begin"); y,tl=loc(n,"end"); edits.append((x-base,y+tl-base,"ctx."+rn+"_x"))
        if n.get("kind")=="DeclRefExpr" and n.get("referencedDecl",{}).get("name") in shared_names:
            x,_=loc(n,"begin"); y,tl=loc(n,"end"); name=n["referencedDecl"]["name"]
            edits.append((x-base,y+tl-base,"shared."+name))
    # Calls are based on resolved declarations, not spelling patterns.
    for n in nodes:
        if n.get("kind")!="CallExpr": continue
        name=refname(n)
        x,_=loc(n,"begin")
        if name=="__syncthreads":
            y,tl=loc(n,"end"); edits.append((x-base,y+tl-base,"co_await ctx.syncthreads()"))
        elif name in device_names:
            edits.append((x-base,x-base,"co_await "))
            dr=next((q for q in walk(n) if q.get("kind")=="DeclRefExpr" and q.get("referencedDecl",{}).get("name")==name),None)
            if dr:
                dx,_=loc(dr,"begin"); dy,dt=loc(dr,"end"); edits.append((dx-base,dy+dt-base,name+"_cpu"))
            # AST identifies the call; locate its already parsed opening token.
            y,tl=loc(n,"end"); op=src.find('(',x,y+tl)
            if op>=0:
                following=src[op+1:y+tl-1].strip(); edits.append((op+1-base,op+1-base,"ctx"+(", " if following else "")))
    for v in shared_nodes:
        x,_=loc(v,"begin"); y,tl=loc(v,"end"); semi=src.find(';',y+tl,y+tl+3)
        edits.append((x-base,semi+1-base,""))
    for q in walk(body):
        if q.get("kind")=="ReturnStmt":
            x,_=loc(q,"begin"); edits.append((x-base,x-base+6,"co_return"))
    if ret=="void": edits.append((z-base,z-base," co_return;"))
    return apply(text,edits)

def main():
    ap=argparse.ArgumentParser(description="Lower a restricted CUDA TU to CPU C++20/OpenMP")
    ap.add_argument("input"); ap.add_argument("-o","--output",required=True)
    ap.add_argument("--clang",default=os.environ.get("CLANG","clang++"))
    ns=ap.parse_args(); src=pathlib.Path(ns.input).read_text(); tree=ast(ns.input,ns.clang)
    validate(tree,src,ns.input)
    funcs=[]
    for n in walk(tree):
        if n.get("kind")!="FunctionDecl" or not child(n,"CompoundStmt"): continue
        b=child(n,"CompoundStmt"); x,_=loc(b,"begin")
        if x is not None and x < len(src): funcs.append(n)
    cuda=[]
    for f in funcs:
        attrs={x.get("kind") for x in f.get("inner",[])}
        if "CUDADeviceAttr" in attrs or "CUDAGlobalAttr" in attrs: cuda.append(f)
    names={f["name"] for f in cuda}
    direct={f["name"]: any(refname(x)=="__syncthreads" for x in walk(child(f,"CompoundStmt")) if x.get("kind")=="CallExpr") for f in cuda}
    calls={f["name"]:{refname(x) for x in walk(child(f,"CompoundStmt")) if x.get("kind")=="CallExpr"} & names for f in cuda}
    changed=True
    while changed:
        changed=False
        for n in names:
            if not direct[n] and any(direct[c] for c in calls[n]): direct[n]=True; changed=True
    kernels=[f for f in cuda if any(x.get("kind")=="CUDAGlobalAttr" for x in f.get("inner",[]))]
    shared_by_kernel={}
    params_by_kernel={}
    generated=[]
    for f in cuda:
        body=child(f,"CompoundStmt"); shared=[]
        for v in walk(body):
            if v.get("kind")=="VarDecl" and v.get("storageClass")=="static" and any(x.get("kind")=="CUDASharedAttr" for x in v.get("inner",[])):
                shared.append(v)
        shared_names={v["name"] for v in shared}; shared_by_kernel[f["name"]]=shared
        ret=f.get("type",{}).get("qualType","void ()").split(" (")[0]
        params=[]; param_types=[]
        for p in (x for x in f.get("inner",[]) if x.get("kind")=="ParmVarDecl"):
            typ=p.get("type",{}).get("qualType","int")
            params.append(typ+" "+p.get("name","arg")); param_types.append(typ)
        iskernel=f in kernels
        if iskernel: params_by_kernel[f["name"]]=param_types
        st=f"Shared_{f['name']}" if iskernel else None
        if iskernel:
            fields=[]
            for v in shared:
                typ=v.get("type",{}).get("qualType","int")
                if "[" in typ:
                    base_t,suffix=typ.split("[",1); fields.append(f"  {base_t} {v['name']}[{suffix};")
                else: fields.append(f"  {typ} {v['name']};")
            generated.append(f"struct {st} {{\n"+"\n".join(fields)+"\n};")
        prefix="cuda2omp::Task<"+ret+"> "+f["name"]+"_cpu(cuda2omp::ThreadContext& ctx"
        if iskernel: prefix+=f", {st}& shared"
        if params: prefix+=", "+", ".join(params)
        prefix+=") "
        btext=transform_body(src,body,names,shared,ret)
        generated.append(prefix+btext)
    # Remove CUDA declarations and transform launch expressions from AST nodes.
    edits=[]
    for f in cuda:
        x,_=loc(f,"begin"); y,tl=loc(f,"end"); edits.append((x,y+tl,""))
    for n in walk(tree):
        if n.get("kind") not in {"CUDAKernelCallExpr", "CallExpr"}: continue
        launch_api=n.get("kind")=="CallExpr" and refname(n)=="cudaLaunchKernel"
        call_parts=n.get("inner",[])
        name=refname(call_parts[1]) if launch_api and len(call_parts)>1 else refname(n)
        if name not in {f['name'] for f in kernels}: continue
        x,_=loc(n,"begin"); y,tl=loc(n,"end"); raw=src[x:y+tl]
        if launch_api:
            if len(call_parts)<5: raise SystemExit("cuda2omp: malformed cudaLaunchKernel call")
            grid=source_text(src,call_parts[2]); block=source_text(src,call_parts[3]); argv=source_text(src,call_parts[4])
            if not all(v is not None for v in (grid,block,argv)):
                raise SystemExit("cuda2omp: malformed cudaLaunchKernel arguments")
            actual=[source_text(src,p) for p in call_parts[5:7]]
            allowed=({"0"}, {"0", "nullptr", "NULL"})
            if any(v is not None and v.strip() not in allowed[i] for i,v in enumerate(actual)):
                raise SystemExit("cuda2omp: dynamic shared memory and streams are unsupported")
            unpack="".join(f", cuda2omp::kernel_arg<{typ}>({argv}, {i})" for i,typ in enumerate(params_by_kernel[name]))
            repl=(f"(cuda2omp::launch<Shared_{name}>(cuda2omp::extent_x({grid}), cuda2omp::extent_x({block}), "
                  f"[&](cuda2omp::ThreadContext& ctx, Shared_{name}& shared) {{ return {name}_cpu(ctx, shared{unpack}); }}), 0)")
        else:
            # AST confirms this is a launch; spelling is used only to preserve argument expressions.
            p=raw.find("<<<"); q=raw.find(">>>",p); cfg=raw[p+3:q].split(','); args=raw[raw.find('(',q)+1:raw.rfind(')')]
            if len(cfg)!=2: raise SystemExit("cuda2omp: only <<<grid, block>>> is supported")
            comma=(", "+args) if args.strip() else ""
            repl=f"cuda2omp::launch<Shared_{name}>({cfg[0]}, {cfg[1]}, [&](cuda2omp::ThreadContext& ctx, Shared_{name}& shared) {{ return {name}_cpu(ctx, shared{comma}); }})"
        edits.append((x,y+tl,repl))
    host=apply(src,edits)
    out='#include "cuda2omp_runtime.hpp"\n'+"\n".join(generated)+"\n"+host
    pathlib.Path(ns.output).write_text(out)
    print("cuda2omp: kernels="+",".join(f['name'] for f in kernels),file=sys.stderr)
    print("cuda2omp: barrier-capable="+",".join(sorted(n for n,v in direct.items() if v)),file=sys.stderr)
if __name__=="__main__": main()
